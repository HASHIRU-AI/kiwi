# --- Kiwi Worker Environment Variables ---
NODE_NAME=worker_1
NODE_URL=http://worker_1:8000
GATEWAY_URL=http://gateway:8080

# Transport Mode (`http` for internal Docker LAN, `p2p` for libp2p internet connection)
KIWI_P2P_TRANSPORT=p2p
KIWI_P2P_PORT=4002
# Multiaddr of the gateway or relay peers to connect to (comma-separated)
KIWI_RELAY_PEERS=/ip4/127.0.0.1/tcp/4001/p2p/<GATEWAY_PEER_ID>

# Compression & Quantization
KIWI_USE_INT8=true
KIWI_USE_CSR=false
KIWI_CSR_SPARSITY=0.40
KIWI_LOSSLESS=zstd

# Memory Management
GPU_MEMORY_RESERVE_MB=512
KIWI_VRAM_GB_OVERRIDE=24.0
